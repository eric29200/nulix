VERSION="4.2"
SRC_FILENAME="dosfstools-"$VERSION".tar.gz"
URL="https://github.com/dosfstools/dosfstools/archive/refs/tags/v"$VERSION".tar.gz"

function configure_port() {
	./autogen.sh
	./configure								\
		--host=$HOST							\
		--prefix="/usr"
}

function build_port() {
	make -j$NJOBS
}

function install_port() {
	make install DESTDIR=$SYSROOT
}
